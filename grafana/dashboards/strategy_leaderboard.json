      "options": { "showHeader": true, "cellHeight": "md", "footer": { "show": false } },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "TimescaleDB" },
        "format": "table",
        "rawQuery": true,
        "rawSql": "WITH sig AS (\n  SELECT strategy_name, count(*) AS signals\n  FROM signals\n  WHERE strategy_name != '' AND strategy_name != 'ensemble' AND time > NOW() - INTERVAL '24 hours'\n  GROUP BY strategy_name\n),\ntrd AS (\n  SELECT strategy_name, count(*) AS trades, COALESCE(SUM(pnl), 0) AS total_pnl,\n    CASE WHEN count(*) > 0 THEN SUM(CASE WHEN pnl > 0 THEN 1 ELSE 0 END)::float / count(*) ELSE 0 END AS win_rate\n  FROM trades\n  WHERE strategy_name != '' AND strategy_name != 'ensemble' AND status = 'FILLED' AND time > NOW() - INTERVAL '24 hours'\n  GROUP BY strategy_name\n),\nalloc AS (\n  SELECT strategy_name, weight\n  FROM strategy_allocations\n  WHERE time = (SELECT MAX(time) FROM strategy_allocations)\n)\nSELECT\n  ROW_NUMBER() OVER (ORDER BY COALESCE(sig.signals, 0) DESC) AS \"Rank\",\n  COALESCE(sig.strategy_name, trd.strategy_name, alloc.strategy_name) AS \"Strategy\",\n  COALESCE(sig.signals, 0) AS \"Signals\",\n  COALESCE(trd.trades, 0) AS \"Trades\",\n  COALESCE(trd.total_pnl, 0) AS \"PnL\",\n  COALESCE(trd.win_rate, 0) AS \"Win%\",\n  COALESCE(alloc.weight, 0.083) AS \"Weight\"\nFROM sig\nFULL OUTER JOIN trd ON sig.strategy_name = trd.strategy_name\nFULL OUTER JOIN alloc ON COALESCE(sig.strategy_name, trd.strategy_name) = alloc.strategy_name\nWHERE COALESCE(sig.strategy_name, trd.strategy_name, alloc.strategy_name) IS NOT NULL\nORDER BY COALESCE(sig.signals, 0) DESC\nLIMIT 12",
        "refId": "A"
      }]
