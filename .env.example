==== Polymarket endpoints (keep defaults unless you know what you're doing) ====
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_DATA_BASE=https://data-api.polymarket.com

==== Detector parameters ====
POLL_INTERVAL_SEC=15
RECENT_WINDOW_SEC=60
BASE_WINDOW_SEC=600
MIN_PRICE_JUMP=0.12
MIN_RECENT_VOLUME=200
DOMINANCE_THRESHOLD=0.8
MIN_RECENT_TRADES=5
MAX_EVENT_AGE_HOURS=6
WATCH_KEYWORDS=
COOLDOWN_SEC=300
LOG_FILE=logs/polymania.log

# ==== War / conflict markets (optional overrides) ====
# These keywords are used to detect long-running war/conflict markets
# such as "Will Israel strike Gaza...", "Israel x Hamas ceasefire...", etc.
# If an event's title/slug contains ANY of these keywords (case-insensitive),
# PolyMania will treat it as a "war/conflict" market and apply a more lenient
# age filter so we don't skip it just because it was created weeks/months ago.
WAR_KEYWORDS=gaza,israel,lebanon,hezbollah,hamas,iran,strike,strikes,offensive,ground offensive,invade,invasion,ceasefire,airstrike,rocket,border

# Max age (in hours) for war/conflict markets ONLY.
# If empty, long-running war markets are NOT age-limited at all.
# Example: 2160 = 90 days.
MAX_EVENT_AGE_HOURS_WAR=2160

# ==== Correlation / cluster parameters (meta-signals) ====
# Enable or disable correlation cluster detection
CORR_ENABLED=true

# Sliding window (in seconds) to look for multiple signals in the same topic
CORR_WINDOW_SEC=600

# How many signals in the same topic within the window are needed to form a cluster
CORR_MIN_SIGNALS_PER_TOPIC=2

# Cooldown (in seconds) between cluster alerts per topic
CORR_COOLDOWN_SEC=900

# ==== Telegram user client (for channel monitoring) ====
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=polymania_session

# ==== Telegram user client scan settings ====
# Comma-separated list of channel usernames, IDs, or links to scan.
# Examples:
#   TG_WATCH_CHANNELS=@channel1,@news_arabic,-1001234567890
TG_WATCH_CHANNELS=

# Comma-separated list of keywords to look for (case-insensitive).
# You can mix Arabic, Hebrew and English terms. For example:
#   TG_WATCH_KEYWORDS=ØºØ²Ø©,Ù‚ØµÙ,ØµÙˆØ§Ø±ÙŠØ®,Ù„Ø¨Ù†Ø§Ù†,Ø­Ø²Ø¨ Ø§Ù„Ù„Ù‡,Ø¥Ø³Ø±Ø§Ø¦ÙŠÙ„,Ø§Ø³Ø±Ø§Ø¦ÙŠÙ„,×¢×–×”,×œ×‘× ×•×Ÿ,×ª×§×™×¤×”,×˜×™×œ×™×,rocket,missile,airstrike
TG_WATCH_KEYWORDS=

# Maximum number of recent messages to scan per channel in a single run
TG_SCAN_LIMIT=200

# Where to log matched messages (CSV path)
TG_HITS_CSV=telegram_hits.csv

==== Telegram alerts (optional, but recommended) ====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

==== News API (optional) ====
# Example: https://newsapi.org
NEWS_API_KEY=your_news_api_key_here
NEWS_LANGUAGE=en

==== Misc ====
LOG_LEVEL=INFO

# Telegram radar loop (VPS)
TG_SCAN_INTERVAL_SEC=60
TG_SCAN_BACKOFF_SEC=30
TG_SCAN_JITTER_SEC=0

# Optional time filter for scanning only recent posts:
# TG_WATCH_SINCE_MINUTES=10
# TG_WATCH_SINCE_HOURS=

# VPS/Docker note:
# In docker-compose we run with working_dir=/app/data and PYTHONPATH=/app,
# so relative paths like logs/... and signals.csv will be created under ./data on the host.

