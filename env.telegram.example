# =====================================================
# TELEGRAM ALPHA SIGNALS CONFIGURATION
# =====================================================
# These channels and keywords are optimized for Polymarket trading.
# Copy the relevant parts to your .env file on the VPS.

# =====================================================
# RECOMMENDED CHANNELS BY CATEGORY
# =====================================================

# --- CRYPTO CHANNELS (for BTC/ETH/SOL price markets) ---
# @whale_alert          - Large crypto transfers (leading indicator)
# @CryptoNewsAlerts     - Breaking crypto news
# @BitcoinMagazine      - Bitcoin-focused news
# @cikirizlansen        - Crypto whale tracking

# --- NEWS/BREAKING CHANNELS (for political/event markets) ---
# @Reuters              - Fast breaking news
# @BBCBreaking          - International news
# @disclosetv           - Alternative news aggregator
# @TheSpectatorIndex    - Political events tracker

# --- SPORTS CHANNELS (for sports betting markets) ---
# @oddspedia            - Sports odds and line movements
# @BetBurgerAlerts      - Value bet alerts

# --- ELON/SOCIAL MARKETS ---
# @ElonMuskNews         - Elon activity tracking
# @TruthSocialBot       - Trump social media tracker

# =====================================================
# CONFIGURATION EXAMPLES
# =====================================================

# EXAMPLE 1: Crypto-focused setup
# TG_WATCH_CHANNELS=whale_alert,CryptoNewsAlerts,cikirizlansen
# TG_WATCH_KEYWORDS=bitcoin,btc,ethereum,eth,solana,sol,xrp,pump,dump,whale,million,billion,transfer,exchange

# EXAMPLE 2: Political/News-focused setup
# TG_WATCH_CHANNELS=Reuters,BBCBreaking,disclosetv,TheSpectatorIndex
# TG_WATCH_KEYWORDS=trump,biden,election,ceasefire,strike,attack,war,peace,deal,agreement,breaking,confirmed

# EXAMPLE 3: Sports-focused setup
# TG_WATCH_CHANNELS=oddspedia,BetBurgerAlerts
# TG_WATCH_KEYWORDS=injury,out,starting,lineup,suspended,odds,line,sharp,steam

# EXAMPLE 4: FULL ALPHA SETUP (recommended)
TG_WATCH_CHANNELS=whale_alert,Reuters,BBCBreaking,disclosetv,ElonMuskNews
TG_WATCH_KEYWORDS=bitcoin,btc,ethereum,solana,trump,biden,election,ceasefire,war,peace,breaking,confirmed,elon,musk,tweet,million,whale

# =====================================================
# TIMING CONFIGURATION
# =====================================================
# How often to scan (seconds) - faster = more API calls but fresher data
TG_SCAN_INTERVAL_SEC=60

# Only look at messages from last N minutes (saves processing)
TG_WATCH_SINCE_MINUTES=30

# Messages to check per channel per scan
TG_WATCH_LIMIT=50

# =====================================================
# OUTPUT
# =====================================================
TG_HITS_CSV=data/telegram_hits.csv

# =====================================================
# KEYWORDS THAT WORK WELL
# =====================================================
# 
# HIGH SIGNAL KEYWORDS (use these!):
# - "breaking" - Usually indicates real news
# - "confirmed" - Event has happened
# - "official" - Authoritative source
# - "whale" - Large money moving (crypto)
# - "million/billion" - Significant amounts
# 
# AVOID THESE (too noisy):
# - "rumor" - Unreliable
# - "maybe/possibly" - Speculation
# - Generic words like "price", "market", "trading"
#
# =====================================================
# PRO TIPS
# =====================================================
# 
# 1. START SMALL: Begin with 2-3 channels, add more once working
# 2. CHECK HITS: Run "python cli.py tg" to see what's being caught
# 3. TUNE KEYWORDS: If too many hits, make keywords more specific
# 4. FRESHNESS MATTERS: Old news = already priced in
# 5. MATCH TO MARKETS: Keywords should match actual Polymarket events
#
